.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# ── Application Logs & Observability Traces ──────────────────────────────────
logs/
backend/logs/
*.log
*.log.*
*.jsonl
logs/traces/

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
.env.local
!.env.example

