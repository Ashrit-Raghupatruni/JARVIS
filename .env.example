# JARVIS Personal AI Operating System - Environment Variables Configuration Guide

# 1. Core LLM Provider (ollama, gemini, groq, openai, openrouter, nvidia)
LLM_PROVIDER=ollama

# Ollama Local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# OLLAMA_MODEL_ALT=qwen3:8b

# Google Gemini
GEMINI_API_KEY=
GEMINI_API_KEY_ALT=
GEMINI_MODEL=gemini-2.0-flash

# Groq Cloud
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (Optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# OpenRouter (Optional)
# OPENROUTER_API_KEY=

# NVIDIA NIM (Optional)
# NVIDIA_API_KEY=
# NIM_MODEL=meta/llama-3.1-8b-instruct

# 2. Voice, Neural TTS & Speech Recognition (STT)
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# TTS Engine (Edge-TTS -> Piper Local Neural -> SAPI)
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+0%

# Piper Neural TTS (Offline zero-latency neural voice)
PIPER_MODEL_PATH=data/models/piper/en_US-lessac-low.onnx
PIPER_CONFIG_PATH=data/models/piper/en_US-lessac-low.onnx.json
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# 3. OAuth2 Enterprise Integrations (Native PKCE)
# Google Workspace (Gmail & Google Calendar)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft 365 (Outlook Mail & Outlook Calendar)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# GitHub (Repositories, Issues, Pull Requests & Profile)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Slack (Channels & Messaging)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Notion (Workspace Pages & Databases)
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# 4. Mobile Companion, Biometrics & FCM Push
JWT_SECRET_KEY=jarvis_personal_mobile_secret_987654321
REQUIRE_BIOMETRIC_FOR_HIGH_RISK=true
FIREBASE_CREDENTIALS_PATH=data/firebase_service_account.json
FIREBASE_PROJECT_ID=jarvis-os-prod

# 5. Local Auto-Discovery & Network
ZEROCONF_ENABLED=true
ZEROCONF_PORT=8000
SERVER_PORT=8000
SERVER_HOST=127.0.0.1

# 6. Sub-Agent Execution Sandbox Quotas
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU_SECONDS=30

# 7. Safety Gatekeeper & Automation
SAFETY_CONFIRM_DANGEROUS=true
SAFETY_ALLOW_TERMINAL=true
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
EASYOCR_ENABLED=true


