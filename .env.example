# ==============================================================================
# JARVIS Personal AI Operating System - Environment Variables Configuration Guide
# ==============================================================================

# ── 1. CORE LLM PROVIDER CONFIGURATION ───────────────────────────────────────
# Default local or cloud provider: ollama, gemini, groq, openai, openrouter, nvidia
LLM_PROVIDER=ollama

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_MODEL_ALT=qwen3:8b

# Google Gemini API Keys (Cloud Provider & Multimodal Vision)
GEMINI_API_KEY=
GEMINI_API_KEY_ALT=
GEMINI_MODEL=gemini-2.0-flash

# Groq Cloud API (Ultra low-latency fast inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Cloud API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# OpenRouter (Multi-model free & paid aggregation)
OPENROUTER_API_KEY=

# NVIDIA NIM API (Enterprise GPU acceleration)
NVIDIA_API_KEY=
NIM_MODEL=meta/llama-3.1-8b-instruct


# ── 2. VOICE, NEURAL TTS & SPEECH RECOGNITION (STT) ─────────────────────────
# Whisper Speech-to-Text Model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# TTS Engine Failover Order: Edge-TTS -> Piper Local Neural -> Windows SAPI
# Online Edge-TTS Voice: en-GB-RyanNeural, en-US-GuyNeural, en-AU-WilliamNeural, en-IN-PrabhatNeural
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+0%

# Piper Neural TTS (Zero-latency offline neural voice)
PIPER_MODEL_PATH=data/models/piper/en_US-lessac-low.onnx
PIPER_CONFIG_PATH=data/models/piper/en_US-lessac-low.onnx.json

# ElevenLabs (Optional premium neural voice)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=


# ── 3. OAUTH2 ENTERPRISE INTEGRATIONS (NATIVE PKCE) ─────────────────────────
# Google Workspace (Gmail & Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 (Outlook Mail & Outlook Calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub (Repositories, Issues, Pull Requests & Profile)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slack (Channels & Messaging)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion (Workspace Pages & Databases)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=


# ── 4. MOBILE COMPANION, BIOMETRICS & FCM PUSH NOTIFICATIONS ────────────────
# Mobile Security JWT Token Signing Secret
JWT_SECRET_KEY=jarvis_personal_mobile_secret_987654321

# Enforce Hardware Biometrics (Fingerprint / Face ID) for High-Risk Commands
REQUIRE_BIOMETRIC_FOR_HIGH_RISK=true

# Firebase Cloud Messaging (FCM) Service Account Credentials for Mobile Push
FIREBASE_CREDENTIALS_PATH=data/firebase_service_account.json
FIREBASE_PROJECT_ID=jarvis-os-prod


# ── 5. LOCAL AUTO-DISCOVERY & NETWORK CONFIGURATION ──────────────────────────
# mDNS / Zeroconf LAN Broadcast (_jarvis._tcp.local.)
ZEROCONF_ENABLED=true
ZEROCONF_PORT=8000

# Backend Server Binding
SERVER_PORT=8000
SERVER_HOST=127.0.0.1


# ── 6. SUB-AGENT RESOURCE QUOTAS & EXECUTION SANDBOX ────────────────────────
# Process Tree RSS Memory Limit in Megabytes (Memory hogs will be terminated)
SANDBOX_MAX_MEMORY_MB=512

# Cumulative CPU Time Quota in Seconds (Infinite loops will be terminated)
SANDBOX_MAX_CPU_SECONDS=30


# ── 7. SAFETY GATEKEEPER & SYSTEM AUTOMATION ────────────────────────────────
SAFETY_CONFIRM_DANGEROUS=true
SAFETY_ALLOW_TERMINAL=true

# Vision & OCR Engine Paths
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
EASYOCR_ENABLED=true

