# JARVIS AI Desktop Assistant — Environment Configuration

# ============================================================
# REQUIRED
# ============================================================

# LLM Provider to use (default: gemini)
# Options: gemini, openai, ollama
LLM_PROVIDER=gemini

# Google Gemini API Key (required if LLM_PROVIDER is gemini)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Gemini model to use (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (required if LLM_PROVIDER is openai or as fallback)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use (default: gpt-4o)
# Options: gpt-4o, gpt-4o-mini, gpt-4.1, gpt-4.1-mini
OPENAI_MODEL=gpt-4o


# Ollama base URL (for local LLM support)
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use (default: qwen2.5-coder:3b)
# OLLAMA_MODEL=qwen2.5-coder:3b

# ============================================================
# OPTIONAL — Voice Configuration
# ============================================================

# Whisper model size (default: small)
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# Whisper device (default: auto)
# Options: auto, cpu, cuda
WHISPER_DEVICE=auto

# Whisper compute type (default: int8 for CPU, float16 for GPU)
# Options: int8, float16, float32
WHISPER_COMPUTE_TYPE=int8

# TTS voice (default: en-US-GuyNeural)
# Run: python -m edge_tts --list-voices  to see all options
TTS_VOICE=en-US-GuyNeural

# TTS rate adjustment (default: +0%)
TTS_RATE=+0%

# Wake word sensitivity threshold (default: 0.5)
WAKE_WORD_THRESHOLD=0.5

# ============================================================
# OPTIONAL — ElevenLabs TTS (premium, requires API key)
# ============================================================

# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-voice-id
# TTS_ENGINE=edge-tts  # Options: edge-tts, elevenlabs

# ============================================================
# OPTIONAL — Server Configuration
# ============================================================

# Backend server port (default: 8000)
SERVER_PORT=8000

# Backend server host (default: 127.0.0.1)
SERVER_HOST=127.0.0.1

# ============================================================
# OPTIONAL — Safety Configuration
# ============================================================

# Require confirmation for dangerous actions (default: true)
SAFETY_CONFIRM_DANGEROUS=true

# Allow terminal command execution (default: true)
SAFETY_ALLOW_TERMINAL=true

# ============================================================
# OPTIONAL — Tesseract OCR Path (Windows)
# ============================================================

# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
